<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Allverter Consulting Limited — Accounting • Audit • Tax • CFO</title>
  <meta name="description" content="Allverter Consulting Limited — Accounting, Audit, Tax, Consulting and Fractional CFO services for startups." />
  <style>
    :root{--blue:#0b5cff;--dark:#0b1b2b;--muted:#6b7280;--glass:rgba(255,255,255,0.06)}
    *{box-sizing:border-box}
    body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;line-height:1.5;margin:0;color:#0f1724;background:#f6f8fb}
    .container{max-width:1100px;margin:0 auto;padding:28px}
    header{display:flex;align-items:center;justify-content:space-between;padding:18px 0}
    .brand{display:flex;gap:12px;align-items:center}
    .logo{width:56px;height:56px;border-radius:8px;background:linear-gradient(135deg,var(--blue),#1a9bff);display:flex;align-items:center;justify-content:center;color:white;font-weight:700}
    nav a{margin-left:18px;color:var(--dark);text-decoration:none;font-weight:600}
    .hero{display:grid;grid-template-columns:1fr 420px;gap:36px;align-items:center;padding:40px 0}
    .hero h1{font-size:34px;margin:0;color:var(--dark)}
    .hero p{color:var(--muted);margin:12px 0 20px}
    .cta{display:flex;gap:12px}
    .btn{background:var(--blue);color:white;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:700}
    .btn-outline{border:2px solid var(--blue);padding:10px 16px;border-radius:8px;color:var(--blue);background:white}
    .card{background:white;border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(10,18,30,0.06)}
    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
    .service{padding:18px;border-radius:10px}
    .service h4{margin:8px 0}
    .pricing{display:flex;gap:16px;margin-top:22px}
    .plan{flex:1;padding:20px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#fbfdff);border:1px solid #e6eefb}
    .plan h3{margin-top:0}
    .process{display:flex;gap:12px;flex-direction:column;margin-top:18px}
    footer{margin-top:36px;padding:28px 0;color:var(--muted);display:flex;justify-content:space-between;align-items:center}
    .contact-form{display:flex;flex-direction:column;gap:10px}
    input,textarea,select{padding:12px;border-radius:8px;border:1px solid #e6eef5;font-size:14px}
    textarea{min-height:120px}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    @media(max-width:900px){
      .hero{grid-template-columns:1fr;}
      .services{grid-template-columns:1fr}
      .grid-2{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand">
        <div class="logo">AC</div>
        <div>
          <div style="font-weight:800;color:var(--dark)">Allverter Consulting Limited</div>
          <div style="font-size:12px;color:var(--muted)">Accounting • Audit • Tax • Consulting • Fractional CFO</div>
        </div>
      </div>
      <nav>
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#process">Process</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <h1>World-class finance support for startups — without the full-time cost</h1>
          <p>Allverter provides Accounting, Audit, Tax, Consulting and Fractional CFO services tailored for startups who can’t yet afford a full-time CFO. Professional accountants from ₦300,000–₦500,000 monthly — we’ll give you CFO-level thinking at a fraction of the price.</p>
          <div class="cta">
            <a class="btn" href="#contact">Get a Free Finance Audit</a>
            <a class="btn-outline" href="#pricing">See Pricing</a>
          </div>

          <div style="margin-top:22px;display:flex;gap:12px">
            <div class="card" style="display:flex;gap:12px;align-items:center">
              <div style="font-size:20px;font-weight:800;color:var(--blue)">70%</div>
              <div>
                <div style="font-weight:700">Lower cost</div>
                <div style="font-size:13px;color:var(--muted)">vs hiring full-time CFO</div>
              </div>
            </div>
            <div class="card" style="display:flex;gap:12px;align-items:center">
              <div style="font-size:20px;font-weight:800;color:var(--blue)">Investor-ready</div>
              <div style="font-size:13px;color:var(--muted)">Clean books for fundraising</div>
            </div>
          </div>
        </div>

        <aside class="card">
          <h3 style="margin-top:0">Ready to start?</h3>
          <p style="color:var(--muted);margin:8px 0">Book a 30-minute discovery call and receive a free finance health-check tailored to your startup.</p>
          <a class="btn" href="#contact">Book a Call</a>
          <div style="margin-top:12px;font-size:13px;color:var(--muted)">Or email us at <strong>info@allverter.com</strong></div>
        </aside>
      </section>

      <section id="services" style="margin-top:26px">
        <h2 style="margin-bottom:8px">Our Services</h2>
        <p style="color:var(--muted);margin-top:0">Comprehensive finance services designed for startups and SMEs.</p>
        <div class="services">
          <div class="card service">
            <h4>Accounting</h4>
            <p style="color:var(--muted);margin:6px 0">Cloud bookkeeping, payroll, reconciliations, monthly management accounts and GST/VAT handling.</p>
          </div>
          <div class="card service">
            <h4>Audit & Assurance</h4>
            <p style="color:var(--muted);margin:6px 0">Statutory audits, internal audit, controls review and audit readiness support for investors.</p>
          </div>
          <div class="card service">
            <h4>Tax Advisory</h4>
            <p style="color:var(--muted);margin:6px 0">Corporate tax, VAT, PAYE, WHT, tax planning, filings and representation during tax audits.</p>
          </div>
        </div>

        <div class="services" style="margin-top:12px">
          <div class="card service">
            <h4>Consulting</h4>
            <p style="color:var(--muted);margin:6px 0">Business modelling, process design, controls, financial strategy and fundraising support.</p>
          </div>
          <div class="card service">
            <h4>Fractional CFO</h4>
            <p style="color:var(--muted);margin:6px 0">Budgeting, forecasting, cashflow management, investor reporting and strategic financial leadership.</p>
          </div>
          <div class="card service">
            <h4>Compliance & Advisory</h4>
            <p style="color:var(--muted);margin:6px 0">Regulatory compliance, FIRS guidance, state tax liaison and policy implementation.</p>
          </div>
        </div>
      </section>

      <section id="pricing" style="margin-top:26px">
        <h2>Pricing</h2>
        <p style="color:var(--muted)">Transparent monthly plans built for startup budgets.</p>
        <div class="pricing">
          <div class="plan card">
            <h3>Starter</h3>
            <div style="font-size:20px;font-weight:800;">₦150,000 / month</div>
            <ul style="color:var(--muted);margin-top:8px;padding-left:18px">
              <li>Bookkeeping & monthly accounts</li>
              <li>Basic tax filing support</li>
              <li>Email support</li>
            </ul>
            <div style="margin-top:12px"><a class="btn" href="#contact">Choose Starter</a></div>
          </div>

          <div class="plan card">
            <h3>Growth</h3>
            <div style="font-size:20px;font-weight:800;">₦250,000 / month</div>
            <ul style="color:var(--muted);margin-top:8px;padding-left:18px">
              <li>Starter + Payroll</li>
              <li>Cashflow monitoring</li>
              <li>Quarterly tax reviews</li>
            </ul>
            <div style="margin-top:12px"><a class="btn" href="#contact">Choose Growth</a></div>
          </div>

          <div class="plan card">
            <h3>Executive (Fractional CFO)</h3>
            <div style="font-size:20px;font-weight:800;">₦350,000 – ₦500,000 / month</div>
            <ul style="color:var(--muted);margin-top:8px;padding-left:18px">
              <li>Growth + Fractional CFO</li>
              <li>Budgeting & investor reporting</li>
              <li>Audit & tax advisory</li>
            </ul>
            <div style="margin-top:12px"><a class="btn" href="#contact">Choose Executive</a></div>
          </div>
        </div>
      </section>

      <section id="process" style="margin-top:26px">
        <h2>How We Work</h2>
        <div class="card process">
          <div class="grid-2">
            <div>
              <h4>1. Assess</h4>
              <p style="color:var(--muted)">We run a finance health-check to identify gaps and priorities.</p>
            </div>
            <div>
              <h4>2. Setup</h4>
              <p style="color:var(--muted)">Cloud accounting system setup and migration (QuickBooks / Zoho / Sage).</p>
            </div>
            <div>
              <h4>3. Run</h4>
              <p style="color:var(--muted)">Monthly bookkeeping, payroll, tax filings and management accounts.</p>
            </div>
            <div>
              <h4>4. Advise</h4>
              <p style="color:var(--muted)">Quarterly CFO sessions, budgeting and fundraising support.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" style="margin-top:26px">
        <h2>Contact Us</h2>
        <div class="card grid-2">
          <div>
            <h4>Get in touch</h4>
            <p style="color:var(--muted)">Book a free 30-minute discovery call and receive a tailored finance health-check for your startup.</p>
            <p style="margin-top:12px"><strong>Email:</strong> info@allverter.com<br><strong>Phone:</strong> +234 812 345 6789<br><strong>Address:</strong> Lagos, Nigeria</p>

            <div style="margin-top:12px">
              <a class="btn" href="mailto:info@allverter.com">Email Us</a>
            </div>
          </div>

          <div>
            <h4>Send a message</h4>
            <form class="contact-form" action="https://formspree.io/f/your_form_id" method="POST">
              <input type="text" name="name" placeholder="Your name" required />
              <input type="email" name="email" placeholder="Your email" required />
              <input type="text" name="company" placeholder="Company (optional)" />
              <textarea name="message" placeholder="How can we help you?" required></textarea>
              <button class="btn" type="submit">Send Message</button>
            </form>
            <div style="font-size:12px;color:var(--muted);margin-top:8px">(This form posts to Formspree — replace the action URL with your form endpoint or your server.)</div>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <div>© Allverter Consulting Limited • 2025</div>
      <div style="text-align:right">
        <div style="font-weight:700;color:var(--dark)">info@allverter.com</div>
        <div style="font-size:13px;color:var(--muted)">Designed for startups • Lagos, Nigeria</div>
      </div>
    </footer>
  </div>
</body>
</html>
